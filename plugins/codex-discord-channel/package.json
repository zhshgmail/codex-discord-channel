{
  "name": "codex-discord-channel",
  "version": "0.3.0",
  "description": "Claude-style Discord channel ownership for Codex sessions.",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "https://github.com/zhshgmail/codex-discord-channel.git"
  },
  "homepage": "https://github.com/zhshgmail/codex-discord-channel",
  "keywords": [
    "discord",
    "codex",
    "channel",
    "mcp",
    "session"
  ],
  "main": "src/mcp-server.js",
  "bin": {
    "codex-discord-channel": "bin/codex-discord-channel"
  },
  "scripts": {
    "syntax": "node --check bin/codex-discord-channel && node --check src/*.js && node --check scripts/*.js && node --check tests/unit/*.test.js",
    "test": "node --test tests/unit/*.test.js",
    "smoke": "node scripts/smoke.js",
    "import:bridge": "node scripts/import-bridge-state.js",
    "check": "npm run syntax && npm test && npm run smoke"
  },
  "dependencies": {
    "discord.js": "^14.19.3",
    "undici": "^7.10.0",
    "ws": "^8.21.0"
  },
  "engines": {
    "node": ">=22.15.0"
  },
  "overrides": {
    "discord.js": {
      "undici": "^6.27.0"
    },
    "@discordjs/rest": {
      "undici": "^6.27.0"
    }
  }
}
