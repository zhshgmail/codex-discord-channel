#!/usr/bin/env bash
set -euo pipefail

usage() {
  echo "Usage: codex-discord-instance INSTANCE [CODEX_ARGS...]" >&2
}

if (($# < 1)); then
  usage
  exit 2
fi

instance=$1
shift
if [[ ! $instance =~ ^[a-zA-Z0-9][a-zA-Z0-9._-]*$ ]]; then
  echo "Invalid Discord instance: $instance" >&2
  exit 2
fi

# The positional instance is the authority boundary.  An alias can be launched
# from a shell (or a resumed TUI) that still carries another instance's
# DISCORD_CONFIG_DIR, so inherited Discord selection must never override it.
state_dir="$HOME/.codex/channels/discord/$instance"
account_env="$state_dir/account.env"
if [[ ! -f $account_env ]]; then
  echo "Missing instance account file: $account_env" >&2
  exit 1
fi

read_account_value() {
  local key=$1
  local count value
  count=$(awk -F= -v key="$key" '$1 == key { count += 1 } END { print count + 0 }' "$account_env")
  if [[ $count != 1 ]]; then
    echo "$account_env must contain exactly one $key entry" >&2
    exit 1
  fi
  value=$(awk -v key="$key" 'index($0, key "=") == 1 { print substr($0, length(key) + 2) }' "$account_env")
  if [[ $value != /* ]]; then
    echo "$key must be an absolute path in $account_env" >&2
    exit 1
  fi
  printf '%s' "$value"
}

node_bin=$(read_account_value NODE_BIN)
codex_bin=$(read_account_value CODEX_BIN)
codex_home=$(read_account_value CODEX_HOME)
launcher_path=$(readlink -f "${BASH_SOURCE[0]}")
plugin_root=$(dirname "$(dirname "$launcher_path")")
channel_bin="$plugin_root/runtime/channel.cjs"
if [[ ! -x $node_bin || ! -f $codex_bin || ! -d $codex_home || ! -f $channel_bin ]]; then
  echo "Instance executable paths are unavailable for $instance" >&2
  exit 1
fi

runtime_args=(--instance "$instance" --state-dir "$state_dir")
child_env_unsets=()
while IFS= read -r name; do
  case $name in
    DISCORD_*|CODEX_DISCORD_*|CODEX_APP_SERVER_URL|CODEX_ACCOUNT_ENV_FILE|CODEX_NETWORK_ENV_FILE)
      child_env_unsets+=(-u "$name")
      ;;
  esac
done < <(compgen -e)
instance_runtime_env=(
  env
  "${child_env_unsets[@]}"
  -u CODEX_THREAD_ID
  -u CODEX_SESSION_ID
  -u CODEX_TARGET_THREAD_ID
  -u CODEX_APP_SERVER_SOCKET
  CODEX_HOME="$codex_home"
  DISCORD_INSTANCE="$instance"
  DISCORD_CONFIG_DIR="$state_dir"
  CODEX_DISCORD_DELIVERY_ACTIVATION_ID="$plugin_root"
)
channel_command=("${instance_runtime_env[@]}" "$node_bin" "$channel_bin")
set +e
"${channel_command[@]}" tui-login-state "${runtime_args[@]}" >/dev/null
login_state=$?
set -e
if ((login_state == 10)); then
  if [[ ! -t 0 || ! -t 1 ]]; then
    echo "OpenAI account login for $instance requires an interactive TTY" >&2
    exit 1
  fi
  env \
    "${child_env_unsets[@]}" \
    -u CODEX_DISCORD_OWNER_ID \
    -u CODEX_THREAD_ID \
    -u CODEX_SESSION_ID \
    -u CODEX_TARGET_THREAD_ID \
    -u CODEX_APP_SERVER_SOCKET \
    CODEX_HOME="$codex_home" \
    "$node_bin" "$codex_bin" login
  "${channel_command[@]}" tui-check "${runtime_args[@]}" >/dev/null
elif ((login_state != 0)); then
  exit "$login_state"
fi

socket="$state_dir/app-server.sock"
lock_file="$state_dir/instance-launcher.lock"
timeout_seconds=${CODEX_DISCORD_START_TIMEOUT_SECONDS:-15}
if [[ ! $timeout_seconds =~ ^[0-9]+$ ]]; then
  echo "CODEX_DISCORD_START_TIMEOUT_SECONDS must be a non-negative integer" >&2
  exit 2
fi
recovery_timeout_seconds=${CODEX_DISCORD_RECOVERY_TIMEOUT_SECONDS:-30}
if [[ ! $recovery_timeout_seconds =~ ^[0-9]+$ ]] \
  || ((recovery_timeout_seconds < 1 || recovery_timeout_seconds > 300)); then
  echo "CODEX_DISCORD_RECOVERY_TIMEOUT_SECONDS must be an integer from 1 to 300" >&2
  exit 2
fi

socket_generation() {
  [[ -S $socket ]] || return 1
  stat -Lc '%d:%i:%z' "$socket"
}

begin_tui_lease() {
  local lease_id=$1
  local started_at_ms=$2
  "${channel_command[@]}" tui-recovery-target begin \
    "$launcher_pid" "$launcher_start_ticks" "$lease_id" "$started_at_ms" \
    "${runtime_args[@]}" >/dev/null
}

snapshot_recovery_target() {
  local minimum_mtime_ms=$1
  local lease_id=$2
  "${channel_command[@]}" tui-recovery-target snapshot "$minimum_mtime_ms" "$lease_id" \
    "${runtime_args[@]}" >/dev/null
}

read_recovery_target() {
  "${channel_command[@]}" tui-recovery-target read "${runtime_args[@]}"
}

watcher_pid=''
watcher_stop=''
app_pid=''
gateway_pid=''
tui_pid=''
socket_owned=0
launcher_lock_owned=0
socket_absence_proven=0
launcher_pid=$$
launcher_start_ticks=$(awk '{print $22}' "/proc/$launcher_pid/stat")
current_lease_id=''
stop_watcher() {
  if [[ -n $watcher_stop ]]; then
    : >"$watcher_stop"
  fi
  if [[ -n $watcher_pid ]]; then
    wait "$watcher_pid" 2>/dev/null || true
  fi
  if [[ -n $watcher_stop ]]; then
    rm -f "$watcher_stop"
  fi
  watcher_pid=''
  watcher_stop=''
}
stop_worker() {
  local pid=$1
  [[ -n $pid ]] || return 0
  if worker_running "$pid"; then
    kill -TERM "$pid" 2>/dev/null || true
    local stop_deadline=$((SECONDS + 5))
    while worker_running "$pid" && ((SECONDS < stop_deadline)); do
      sleep 0.05
    done
    if worker_running "$pid"; then
      kill -KILL "$pid" 2>/dev/null || true
    fi
  fi
  wait "$pid" 2>/dev/null || true
}
worker_running() {
  local pid=$1
  local state
  kill -0 "$pid" 2>/dev/null || return 1
  state=$(awk '{print $3}' "/proc/$pid/stat" 2>/dev/null || true)
  [[ $state != Z && -n $state ]]
}
cleanup_launcher() {
  local status=$?
  local may_remove_socket=0
  trap - EXIT
  stop_watcher
  if [[ -n $current_lease_id ]]; then
    "${channel_command[@]}" tui-recovery-target clear-owned "$current_lease_id" \
      "${runtime_args[@]}" >/dev/null 2>&1 || true
  fi
  stop_worker "$tui_pid"
  stop_worker "$gateway_pid"
  if ((launcher_lock_owned == 1 && socket_absence_proven == 1)) && [[ -n $app_pid ]]; then
    may_remove_socket=1
  fi
  stop_worker "$app_pid"
  if ((socket_owned == 1 || may_remove_socket == 1)); then
    rm -f "$socket"
  fi
  exit "$status"
}
trap cleanup_launcher EXIT
trap 'exit 130' INT
trap 'exit 143' TERM

exec {launcher_lock_fd}>"$lock_file"
if ! flock -n "$launcher_lock_fd"; then
  echo "Discord instance $instance already has an active launcher" >&2
  exit 73
fi
launcher_lock_owned=1
if [[ -e $socket ]]; then
  echo "Discord instance $instance already has an app-server socket; stop the legacy service before relaunching" >&2
  exit 73
fi
socket_absence_proven=1

umask 077
"${channel_command[@]}" app-server "${runtime_args[@]}" \
  >>"$state_dir/app-server.log" 2>&1 &
app_pid=$!
"${channel_command[@]}" gateway "${runtime_args[@]}" \
  >>"$state_dir/session-gateway.log" 2>&1 &
gateway_pid=$!

deadline=$((SECONDS + timeout_seconds))
while ((SECONDS <= deadline)); do
  # The socket was proven absent after this launcher acquired the instance lock.
  # Any socket observed after its app-server child starts belongs to this launch,
  # even if the sibling gateway fails before the full live-check can complete.
  if [[ -S $socket ]]; then
    socket_owned=1
  fi
  if ! worker_running "$app_pid"; then
    echo "Discord app-server for $instance exited during startup; see $state_dir/app-server.log" >&2
    exit 1
  fi
  if ! worker_running "$gateway_pid"; then
    echo "Discord gateway for $instance exited during startup; see $state_dir/session-gateway.log" >&2
    exit 1
  fi
  if [[ -S $socket ]]; then
    "${channel_command[@]}" live-check "${runtime_args[@]}" \
      --pid "$app_pid" --pid "$gateway_pid" >/dev/null
    codex_args=("$@")
    recovery_stamps=()
    while true; do
      launch_generation=$(socket_generation)
      launch_mtime_ms=$(date +%s%3N)
      current_lease_id=$(tr -d '\n' </proc/sys/kernel/random/uuid)
      begin_tui_lease "$current_lease_id" "$launch_mtime_ms"
      watcher_stop=$(mktemp "$state_dir/.tui-recovery-stop.XXXXXX")
      rm -f "$watcher_stop"
      (
        while [[ ! -e $watcher_stop ]] && kill -0 "$launcher_pid" 2>/dev/null; do
          snapshot_recovery_target "$launch_mtime_ms" "$current_lease_id" 2>/dev/null || true
          sleep 0.2
        done
      ) &
      watcher_pid=$!

      set +e
      env \
        "${child_env_unsets[@]}" \
        -u CODEX_THREAD_ID \
        -u CODEX_SESSION_ID \
        -u CODEX_TARGET_THREAD_ID \
        -u CODEX_APP_SERVER_SOCKET \
        CODEX_HOME="$codex_home" \
        DISCORD_INSTANCE="$instance" \
        DISCORD_CONFIG_DIR="$state_dir" \
        CODEX_DISCORD_DELIVERY_ACTIVATION_ID="$plugin_root" \
        "$node_bin" "$codex_bin" --remote "unix://$socket" "${codex_args[@]}" \
        <&0 >&1 2>&2 &
      tui_pid=$!
      completed_pid=''
      wait -n -p completed_pid "$tui_pid" "$app_pid" "$gateway_pid"
      child_status=$?
      set -e
      if [[ $completed_pid != "$tui_pid" ]]; then
        failed_worker=app-server
        if [[ $completed_pid == "$gateway_pid" ]]; then
          failed_worker=gateway
          gateway_pid=''
        elif [[ $completed_pid == "$app_pid" ]]; then
          app_pid=''
        fi
        stop_worker "$tui_pid"
        tui_pid=''
        echo "Discord $failed_worker for $instance exited while the TUI was active" >&2
        exit 75
      fi
      tui_status=$child_status
      tui_pid=''
      stop_watcher
      snapshot_recovery_target "$launch_mtime_ms" "$current_lease_id" 2>/dev/null || true

      if ((tui_status == 0 || tui_status == 130 || tui_status == 143)); then
        "${channel_command[@]}" tui-recovery-target clear-owned "$current_lease_id" \
          "${runtime_args[@]}" >/dev/null
        exit "$tui_status"
      fi

      current_generation=$(socket_generation 2>/dev/null || true)
      if [[ -n $current_generation && $current_generation == "$launch_generation" ]]; then
        exit "$tui_status"
      fi

      recovery_deadline=$((SECONDS + recovery_timeout_seconds))
      next_generation=''
      while ((SECONDS <= recovery_deadline)); do
        next_generation=$(socket_generation 2>/dev/null || true)
        if [[ -n $next_generation && $next_generation != "$launch_generation" ]]; then
          break
        fi
        sleep 0.1
      done
      if [[ -z $next_generation || $next_generation == "$launch_generation" ]]; then
        exit "$tui_status"
      fi

      set +e
      recovery_thread=$(read_recovery_target 2>/dev/null)
      recovery_target_status=$?
      set -e
      if ((recovery_target_status != 0)) || [[ -z $recovery_thread ]]; then
        exit "$tui_status"
      fi

      now_seconds=$(date +%s)
      retained_stamps=()
      for stamp in "${recovery_stamps[@]}"; do
        if ((now_seconds - stamp < 60)); then
          retained_stamps+=("$stamp")
        fi
      done
      recovery_stamps=("${retained_stamps[@]}")
      if ((${#recovery_stamps[@]} >= 5)); then
        echo "App-server recovery stopped after five replacements in one minute" >&2
        exit 75
      fi
      recovery_stamps+=("$now_seconds")

      recovered_args=()
      option_index=0
      while ((option_index < ${#codex_args[@]})); do
        arg=${codex_args[$option_index]}
        if [[ $arg == -- ]] || [[ $arg != -* ]]; then
          break
        fi
        case $arg in
          --oss|--full-auto|--dangerously-bypass-approvals-and-sandbox|--search|--no-alt-screen)
            recovered_args+=("$arg")
            option_index=$((option_index + 1))
            ;;
          --image=*)
            option_index=$((option_index + 1))
            ;;
          --config=*|--enable=*|--disable=*|--model=*|--local-provider=*|--profile=*|--sandbox=*|--ask-for-approval=*|--cd=*|--add-dir=*)
            recovered_args+=("$arg")
            option_index=$((option_index + 1))
            ;;
          -i|--image)
            if ((option_index + 1 >= ${#codex_args[@]})); then
              echo "App-server recovery cannot discard $arg without its value" >&2
              exit "$tui_status"
            fi
            option_index=$((option_index + 2))
            ;;
          -c|--config|--enable|--disable|-m|--model|--local-provider|-p|--profile|-s|--sandbox|-a|--ask-for-approval|-C|--cd|--add-dir)
            if ((option_index + 1 >= ${#codex_args[@]})); then
              echo "App-server recovery cannot preserve $arg without its value" >&2
              exit "$tui_status"
            fi
            recovered_args+=("$arg" "${codex_args[$((option_index + 1))]}")
            option_index=$((option_index + 2))
            ;;
          *)
            echo "App-server recovery refuses unknown global option $arg" >&2
            exit "$tui_status"
            ;;
        esac
      done
      recovered_args+=(resume "$recovery_thread")
      codex_args=("${recovered_args[@]}")
      echo "App-server generation changed; resuming thread $recovery_thread." >&2
    done
  fi
  sleep 0.1
done

echo "Discord instance $instance did not become ready within the startup timeout" >&2
exit 1
