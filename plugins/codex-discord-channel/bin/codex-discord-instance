#!/usr/bin/env bash
set -euo pipefail

usage() {
  echo "Usage: codex-discord-instance INSTANCE [CODEX_ARGS...]" >&2
}

if (($# < 1)); then
  usage
  exit 2
fi

instance=$1
shift
if [[ ! $instance =~ ^[a-zA-Z0-9][a-zA-Z0-9._-]*$ ]]; then
  echo "Invalid Discord instance: $instance" >&2
  exit 2
fi

state_dir=${DISCORD_CONFIG_DIR:-"$HOME/.codex/channels/discord/$instance"}
account_env="$state_dir/account.env"
if [[ ! -f $account_env ]]; then
  echo "Missing instance account file: $account_env" >&2
  exit 1
fi

read_account_value() {
  local key=$1
  local count value
  count=$(awk -F= -v key="$key" '$1 == key { count += 1 } END { print count + 0 }' "$account_env")
  if [[ $count != 1 ]]; then
    echo "$account_env must contain exactly one $key entry" >&2
    exit 1
  fi
  value=$(awk -v key="$key" 'index($0, key "=") == 1 { print substr($0, length(key) + 2) }' "$account_env")
  if [[ $value != /* ]]; then
    echo "$key must be an absolute path in $account_env" >&2
    exit 1
  fi
  printf '%s' "$value"
}

node_bin=$(read_account_value NODE_BIN)
codex_bin=$(read_account_value CODEX_BIN)
codex_home=$(read_account_value CODEX_HOME)
channel_bin=$(read_account_value CODEX_DISCORD_CHANNEL_BIN)
if [[ ! -x $node_bin || ! -f $codex_bin || ! -d $codex_home || ! -f $channel_bin ]]; then
  echo "Instance executable paths are unavailable for $instance" >&2
  exit 1
fi

runtime_args=(--instance "$instance" --state-dir "$state_dir")
codex_env=(env -i)
codex_env_allowlist=(
  HOME PATH USER LOGNAME SHELL
  TERM COLORTERM TERMINFO NO_COLOR FORCE_COLOR
  LANG LANGUAGE LC_ALL LC_CTYPE TZ TMPDIR
  XDG_RUNTIME_DIR XDG_CONFIG_HOME XDG_CACHE_HOME XDG_DATA_HOME
  SSH_AUTH_SOCK
  HTTP_PROXY HTTPS_PROXY ALL_PROXY NO_PROXY
  http_proxy https_proxy all_proxy no_proxy
  SSL_CERT_FILE SSL_CERT_DIR CURL_CA_BUNDLE REQUESTS_CA_BUNDLE NODE_EXTRA_CA_CERTS
  OPENAI_API_KEY OPENAI_BASE_URL OPENAI_ORGANIZATION OPENAI_PROJECT
  AZURE_OPENAI_API_KEY AZURE_OPENAI_ENDPOINT
)
for key in "${codex_env_allowlist[@]}"; do
  if [[ -v $key ]]; then
    codex_env+=("$key=${!key}")
  fi
done
codex_env+=("CODEX_HOME=$codex_home")
set +e
"$node_bin" "$channel_bin" tui-login-state "${runtime_args[@]}" >/dev/null
login_state=$?
set -e
if ((login_state == 10)); then
  if [[ ! -t 0 || ! -t 1 ]]; then
    echo "OpenAI account login for $instance requires an interactive TTY" >&2
    exit 1
  fi
  "${codex_env[@]}" \
    "$node_bin" "$codex_bin" login
  "$node_bin" "$channel_bin" tui-check "${runtime_args[@]}" >/dev/null
elif ((login_state != 0)); then
  exit "$login_state"
fi

app_service="codex-discord-app-server@$instance.service"
gateway_service="codex-discord-channel@$instance.service"
systemctl --user enable --now "$app_service" "$gateway_service" >/dev/null

socket="$state_dir/app-server.sock"
timeout_seconds=${CODEX_DISCORD_START_TIMEOUT_SECONDS:-15}
if [[ ! $timeout_seconds =~ ^[0-9]+$ ]]; then
  echo "CODEX_DISCORD_START_TIMEOUT_SECONDS must be a non-negative integer" >&2
  exit 2
fi
recovery_timeout_seconds=${CODEX_DISCORD_RECOVERY_TIMEOUT_SECONDS:-30}
if [[ ! $recovery_timeout_seconds =~ ^[0-9]+$ ]] \
  || ((recovery_timeout_seconds < 1 || recovery_timeout_seconds > 300)); then
  echo "CODEX_DISCORD_RECOVERY_TIMEOUT_SECONDS must be an integer from 1 to 300" >&2
  exit 2
fi

socket_generation() {
  [[ -S $socket ]] || return 1
  stat -Lc '%d:%i:%z' "$socket"
}

clear_recovery_target() {
  "$node_bin" "$channel_bin" tui-recovery-target clear "${runtime_args[@]}" >/dev/null
}

snapshot_recovery_target() {
  local minimum_mtime_ms=$1
  local capture_id=$2
  "$node_bin" "$channel_bin" tui-recovery-target snapshot "$capture_id" "$minimum_mtime_ms" \
    "${runtime_args[@]}" >/dev/null
}

read_recovery_target() {
  local capture_id=$1
  "$node_bin" "$channel_bin" tui-recovery-target read "$capture_id" "${runtime_args[@]}"
}

new_capture_id() {
  printf '%s-%s-%s-%s' "$BASHPID" "$RANDOM" "$RANDOM" "$(date +%s%N)"
}

option_requires_value() {
  case $1 in
    -c|--config|--enable|--disable|--remote|--remote-auth-token-env|-m|--model|--local-provider|-p|--profile|-s|--sandbox|-a|--ask-for-approval|-C|--cd|--add-dir)
      return 0
      ;;
    *)
      return 1
      ;;
  esac
}

reconstruct_recovery_args() {
  local recovery_thread=$1
  local arg candidate
  local -i arg_index image_value_count resume_index=-1 unsafe_positional=0
  local -i args_count=${#codex_args[@]}

  arg_index=0
  while ((arg_index < args_count)); do
    arg=${codex_args[$arg_index]}
    if [[ $arg == resume ]]; then
      resume_index=$arg_index
      break
    fi
    if option_requires_value "$arg"; then
      if ((arg_index + 1 >= args_count)) || [[ ${codex_args[$((arg_index + 1))]} == -* ]]; then
        return 1
      fi
      arg_index=$((arg_index + 2))
      continue
    fi
    if [[ $arg == -i || $arg == --image ]]; then
      arg_index=$((arg_index + 1))
      image_value_count=0
      while ((arg_index < args_count)); do
        candidate=${codex_args[$arg_index]}
        [[ $candidate == -- ]] && return 1
        if [[ $candidate == resume && $image_value_count -gt 0 ]]; then
          resume_index=$arg_index
          break 2
        fi
        [[ $candidate == -* ]] && break
        image_value_count=$((image_value_count + 1))
        arg_index=$((arg_index + 1))
      done
      ((image_value_count == 0)) && return 1
      continue
    fi
    [[ $arg == -- ]] && return 1
    [[ $arg != -* ]] && unsafe_positional=1
    arg_index=$((arg_index + 1))
  done

  recovered_args=("${codex_args[@]}")
  if ((resume_index < 0)); then
    ((unsafe_positional > 0)) && return 1
    recovered_args+=(resume "$recovery_thread")
    return
  fi

  local -A positional_indices=()
  local -a image_starts=() image_ends=()
  local -i definite_positionals=0 last_index=-1
  local -i block_start block_end scan_index
  arg_index=$((resume_index + 1))
  while ((arg_index < args_count)); do
    arg=${codex_args[$arg_index]}
    if [[ $arg == --last ]]; then
      last_index=$arg_index
      arg_index=$((arg_index + 1))
      continue
    fi
    if [[ $arg == -- ]]; then
      return 1
    fi
    if option_requires_value "$arg"; then
      if ((arg_index + 1 >= args_count)) || [[ ${codex_args[$((arg_index + 1))]} == -* ]]; then
        return 1
      fi
      arg_index=$((arg_index + 2))
      continue
    fi
    if [[ $arg == -i || $arg == --image ]]; then
      block_start=$((arg_index + 1))
      block_end=$block_start
      while ((block_end < args_count)) && [[ ${codex_args[$block_end]} != -* ]]; do
        block_end=$((block_end + 1))
      done
      if ((block_end == block_start)); then
        return 1
      fi
      image_starts+=("$block_start")
      image_ends+=("$((block_end - 1))")
      arg_index=$block_end
      continue
    fi
    if [[ $arg == --*=* || $arg == -* ]]; then
      arg_index=$((arg_index + 1))
      continue
    fi
    positional_indices[$arg_index]=1
    definite_positionals=$((definite_positionals + 1))
    arg_index=$((arg_index + 1))
  done

  if ((last_index >= 0)); then
    recovered_args[$last_index]=$recovery_thread
    return
  fi

  local -i remaining_positionals=$((2 - definite_positionals))
  ((remaining_positionals < 0)) && remaining_positionals=0
  local -i block_index available take first_positional
  for ((block_index = ${#image_starts[@]} - 1; block_index >= 0 && remaining_positionals > 0; block_index -= 1)); do
    block_start=${image_starts[$block_index]}
    block_end=${image_ends[$block_index]}
    available=$((block_end - block_start))
    ((available <= 0)) && continue
    take=$available
    ((take > remaining_positionals)) && take=$remaining_positionals
    first_positional=$((block_end - take + 1))
    for ((scan_index = first_positional; scan_index <= block_end; scan_index += 1)); do
      positional_indices[$scan_index]=1
    done
    remaining_positionals=$((remaining_positionals - take))
  done

  for ((scan_index = resume_index + 1; scan_index < args_count; scan_index += 1)); do
    if [[ -n ${positional_indices[$scan_index]+x} ]]; then
      recovered_args[$scan_index]=$recovery_thread
      return
    fi
  done
  recovered_args+=("$recovery_thread")
}

watcher_pid=''
watcher_stop=''
stop_watcher() {
  if [[ -n $watcher_stop ]]; then
    : >"$watcher_stop"
  fi
  if [[ -n $watcher_pid ]]; then
    wait "$watcher_pid" 2>/dev/null || true
  fi
  if [[ -n $watcher_stop ]]; then
    rm -f "$watcher_stop"
  fi
  watcher_pid=''
  watcher_stop=''
}
trap stop_watcher EXIT

deadline=$((SECONDS + timeout_seconds))
while ((SECONDS <= deadline)); do
  if systemctl --user is-active --quiet "$app_service" \
    && systemctl --user is-active --quiet "$gateway_service" \
    && [[ -S $socket ]]; then
    app_pid=$(systemctl --user show --property MainPID --value "$app_service")
    gateway_pid=$(systemctl --user show --property MainPID --value "$gateway_service")
    "$node_bin" "$channel_bin" live-check "${runtime_args[@]}" \
      --pid "$app_pid" --pid "$gateway_pid" >/dev/null
    clear_recovery_target
    codex_args=("$@")
    recovery_stamps=()
    while true; do
      launch_generation=$(socket_generation)
      launch_mtime_ms=$(date +%s%3N)
      watcher_stop=$(mktemp "$state_dir/.tui-recovery-stop.XXXXXX")
      rm -f "$watcher_stop"
      (
        while [[ ! -e $watcher_stop ]]; do
          watcher_capture_id=$(new_capture_id)
          if snapshot_recovery_target "$launch_mtime_ms" "$watcher_capture_id" 2>/dev/null; then
            :
          fi
          sleep 0.2
        done
      ) &
      watcher_pid=$!

      set +e
      "${codex_env[@]}" \
        "$node_bin" "$codex_bin" --remote "unix://$socket" "${codex_args[@]}"
      tui_status=$?
      set -e
      stop_watcher

      if ((tui_status == 0 || tui_status == 130 || tui_status == 143)); then
        clear_recovery_target
        exit "$tui_status"
      fi

      recovery_capture_id=$(new_capture_id)
      set +e
      snapshot_recovery_target "$launch_mtime_ms" "$recovery_capture_id" 2>/dev/null
      recovery_capture_status=$?
      set -e
      if ((recovery_capture_status != 0)); then
        exit "$tui_status"
      fi

      current_generation=$(socket_generation 2>/dev/null || true)
      if [[ -n $current_generation && $current_generation == "$launch_generation" ]]; then
        exit "$tui_status"
      fi

      recovery_deadline=$((SECONDS + recovery_timeout_seconds))
      next_generation=''
      while ((SECONDS <= recovery_deadline)); do
        next_generation=$(socket_generation 2>/dev/null || true)
        if [[ -n $next_generation && $next_generation != "$launch_generation" ]]; then
          break
        fi
        sleep 0.1
      done
      if [[ -z $next_generation || $next_generation == "$launch_generation" ]]; then
        exit "$tui_status"
      fi

      set +e
      recovery_thread=$(read_recovery_target "$recovery_capture_id" 2>/dev/null)
      recovery_target_status=$?
      set -e
      if ((recovery_target_status != 0)) || [[ -z $recovery_thread ]]; then
        exit "$tui_status"
      fi

      now_seconds=$(date +%s)
      retained_stamps=()
      for stamp in "${recovery_stamps[@]}"; do
        if ((now_seconds - stamp < 60)); then
          retained_stamps+=("$stamp")
        fi
      done
      recovery_stamps=("${retained_stamps[@]}")
      if ((${#recovery_stamps[@]} >= 5)); then
        echo "App-server recovery stopped after five replacements in one minute" >&2
        exit 75
      fi
      recovery_stamps+=("$now_seconds")

      if ! reconstruct_recovery_args "$recovery_thread"; then
        exit "$tui_status"
      fi
      codex_args=("${recovered_args[@]}")
      echo "App-server generation changed; resuming thread $recovery_thread." >&2
    done
  fi
  sleep 0.1
done

echo "Discord instance $instance did not become ready within the startup timeout" >&2
exit 1
