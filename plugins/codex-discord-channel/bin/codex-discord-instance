#!/usr/bin/env bash
set -euo pipefail

usage() {
  echo "Usage: codex-discord-instance INSTANCE [CODEX_ARGS...]" >&2
}

if (($# < 1)); then
  usage
  exit 2
fi

instance=$1
shift
if [[ ! $instance =~ ^[a-zA-Z0-9][a-zA-Z0-9._-]*$ ]]; then
  echo "Invalid Discord instance: $instance" >&2
  exit 2
fi

# The positional instance is the authority boundary.  An alias can be launched
# from a shell (or a resumed TUI) that still carries another instance's
# DISCORD_CONFIG_DIR, so inherited Discord selection must never override it.
state_dir="$HOME/.codex/channels/discord/$instance"
account_env="$state_dir/account.env"
if [[ ! -f $account_env ]]; then
  echo "Missing instance account file: $account_env" >&2
  exit 1
fi

read_account_value() {
  local key=$1
  local count value
  count=$(awk -F= -v key="$key" '$1 == key { count += 1 } END { print count + 0 }' "$account_env")
  if [[ $count != 1 ]]; then
    echo "$account_env must contain exactly one $key entry" >&2
    exit 1
  fi
  value=$(awk -v key="$key" 'index($0, key "=") == 1 { print substr($0, length(key) + 2) }' "$account_env")
  if [[ $value != /* ]]; then
    echo "$key must be an absolute path in $account_env" >&2
    exit 1
  fi
  printf '%s' "$value"
}

node_bin=$(read_account_value NODE_BIN)
codex_bin=$(read_account_value CODEX_BIN)
codex_home=$(read_account_value CODEX_HOME)
launcher_path=$(readlink -f "${BASH_SOURCE[0]}")
plugin_root=$(dirname "$(dirname "$launcher_path")")
channel_bin="$plugin_root/runtime/channel.cjs"
generation_bin="$plugin_root/bin/codex-discord-generation"
setsid_bin=$(command -v setsid 2>/dev/null || true)
if [[ ! -x $node_bin || ! -f $codex_bin || ! -d $codex_home || ! -f $channel_bin \
  || ! -f $generation_bin || -z $setsid_bin || ! -x $setsid_bin ]]; then
  echo "Instance executable paths are unavailable for $instance" >&2
  exit 1
fi

runtime_args=(--instance "$instance" --state-dir "$state_dir")
child_env_unsets=()
while IFS= read -r name; do
  case $name in
    DISCORD_*|CODEX_DISCORD_*|CODEX_APP_SERVER_URL|CODEX_ACCOUNT_ENV_FILE|CODEX_NETWORK_ENV_FILE)
      child_env_unsets+=(-u "$name")
      ;;
  esac
done < <(compgen -e)
instance_runtime_env=(
  env
  "${child_env_unsets[@]}"
  -u CODEX_THREAD_ID
  -u CODEX_SESSION_ID
  -u CODEX_TARGET_THREAD_ID
  -u CODEX_APP_SERVER_SOCKET
  CODEX_HOME="$codex_home"
  DISCORD_INSTANCE="$instance"
  DISCORD_CONFIG_DIR="$state_dir"
  CODEX_DISCORD_DELIVERY_ACTIVATION_ID="$plugin_root"
)
channel_command=("${instance_runtime_env[@]}" "$node_bin" "$channel_bin")
set +e
"${channel_command[@]}" tui-login-state "${runtime_args[@]}" >/dev/null
login_state=$?
set -e
if ((login_state == 10)); then
  if [[ ! -t 0 || ! -t 1 ]]; then
    echo "OpenAI account login for $instance requires an interactive TTY" >&2
    exit 1
  fi
  env \
    "${child_env_unsets[@]}" \
    -u CODEX_DISCORD_OWNER_ID \
    -u CODEX_THREAD_ID \
    -u CODEX_SESSION_ID \
    -u CODEX_TARGET_THREAD_ID \
    -u CODEX_APP_SERVER_SOCKET \
    CODEX_HOME="$codex_home" \
    "$node_bin" "$codex_bin" login
  "${channel_command[@]}" tui-check "${runtime_args[@]}" >/dev/null
elif ((login_state != 0)); then
  exit "$login_state"
fi

socket="$state_dir/app-server.sock"
lock_file="$state_dir/instance-launcher.lock"
timeout_seconds=${CODEX_DISCORD_START_TIMEOUT_SECONDS:-15}
if [[ ! $timeout_seconds =~ ^[0-9]+$ ]]; then
  echo "CODEX_DISCORD_START_TIMEOUT_SECONDS must be a non-negative integer" >&2
  exit 2
fi
recovery_timeout_seconds=${CODEX_DISCORD_RECOVERY_TIMEOUT_SECONDS:-30}
if [[ ! $recovery_timeout_seconds =~ ^[0-9]+$ ]] \
  || ((recovery_timeout_seconds < 1 || recovery_timeout_seconds > 300)); then
  echo "CODEX_DISCORD_RECOVERY_TIMEOUT_SECONDS must be an integer from 1 to 300" >&2
  exit 2
fi
stop_timeout_ms=${CODEX_DISCORD_STOP_TIMEOUT_MS:-5000}
if [[ ! $stop_timeout_ms =~ ^[0-9]+$ ]] || ((stop_timeout_ms < 50 || stop_timeout_ms > 30000)); then
  echo "CODEX_DISCORD_STOP_TIMEOUT_MS must be an integer from 50 to 30000" >&2
  exit 2
fi

socket_generation() {
  [[ -S $socket ]] || return 1
  stat -Lc '%d:%i:%z' "$socket"
}

begin_tui_lease() {
  local lease_id=$1
  local started_at_ms=$2
  "${channel_command[@]}" tui-recovery-target begin \
    "$launcher_pid" "$launcher_start_ticks" "$lease_id" "$started_at_ms" \
    "${runtime_args[@]}" >/dev/null
}

snapshot_recovery_target() {
  local minimum_mtime_ms=$1
  local lease_id=$2
  "${channel_command[@]}" tui-recovery-target snapshot "$minimum_mtime_ms" "$lease_id" \
    "${runtime_args[@]}" >/dev/null
}

read_recovery_target() {
  "${channel_command[@]}" tui-recovery-target read "${runtime_args[@]}"
}

watcher_pid=''
watcher_stop=''
app_pid=''
app_start_ticks=''
app_pgid=''
gateway_pid=''
gateway_start_ticks=''
gateway_pgid=''
tui_pid=''
tui_start_ticks=''
tui_pgid=''
launcher_pid=$$
launcher_start_ticks=$(awk '{print $22}' "/proc/$launcher_pid/stat")
current_lease_id=''
launch_generation=''
generation_manifest="$state_dir/instance-generation.json"
generation_command=("$node_bin" "$generation_bin")
stop_watcher() {
  if [[ -n $watcher_stop ]]; then
    : >"$watcher_stop"
  fi
  if [[ -n $watcher_pid ]]; then
    wait "$watcher_pid" 2>/dev/null || true
  fi
  if [[ -n $watcher_stop ]]; then
    rm -f "$watcher_stop"
  fi
  watcher_pid=''
  watcher_stop=''
}
generation_identity_args() {
  printf '%s\0' \
    --manifest "$generation_manifest" \
    --instance "$instance" \
    --state-dir "$state_dir" \
    --codex-home "$codex_home" \
    --plugin-root "$plugin_root" \
    --socket "$socket" \
    --node-bin "$node_bin" \
    --codex-bin "$codex_bin" \
    --channel-bin "$channel_bin" \
    --generation-bin "$generation_bin"
}
run_generation() {
  local action=$1
  shift
  local identity_args=()
  while IFS= read -r -d '' value; do identity_args+=("$value"); done < <(generation_identity_args)
  if [[ -n ${launcher_lock_fd-} ]]; then
    (
      exec {launcher_lock_fd}>&-
      exec "${generation_command[@]}" "$action" "${identity_args[@]}" "$@"
    )
  else
    "${generation_command[@]}" "$action" "${identity_args[@]}" "$@"
  fi
}
record_worker_group() {
  local pid=$1
  local identity=''
  local attempt
  for ((attempt = 0; attempt < 100; attempt += 1)); do
    identity=$(awk '{print $5 " " $22}' "/proc/$pid/stat" 2>/dev/null || true)
    [[ -n $identity ]] && break
    sleep 0.01
  done
  [[ -n $identity ]] || return 1
  local pgid start_ticks
  read -r pgid start_ticks <<<"$identity"
  [[ $pgid == "$pid" ]] || return 1
  printf '%s %s\n' "$start_ticks" "$pgid"
}
group_state() {
  local role=$1
  local pid=$2
  local start_ticks=$3
  local pgid=$4
  run_generation group-state \
    --nonce "$launch_generation" \
    --role "$role" \
    --leader-pid "$pid" \
    --leader-start-ticks "$start_ticks" \
    --pgid "$pgid" >/dev/null
}
stop_worker_group() {
  local role=$1
  local pid=$2
  local start_ticks=$3
  local pgid=$4
  [[ -n $pid && -n $start_ticks && -n $pgid ]] || return 0
  local state_status=0
  set +e
  group_state "$role" "$pid" "$start_ticks" "$pgid"
  state_status=$?
  set -e
  if ((state_status == 10)); then
    wait "$pid" 2>/dev/null || true
    return 0
  fi
  if ((state_status != 0)); then
    echo "Refusing to stop unverified $role process group $pgid" >&2
    return 0
  fi
  kill -TERM -- "-$pgid" 2>/dev/null || true
  local attempts=$(((stop_timeout_ms + 49) / 50))
  local attempt
  for ((attempt = 0; attempt < attempts; attempt += 1)); do
    set +e
    group_state "$role" "$pid" "$start_ticks" "$pgid"
    state_status=$?
    set -e
    ((state_status == 10)) && break
    if ((state_status != 0)); then
      echo "Refusing to continue stopping changed $role process group $pgid" >&2
      break
    fi
    sleep 0.05
  done
  if ((state_status == 0)); then
    kill -KILL -- "-$pgid" 2>/dev/null || true
  fi
  wait "$pid" 2>/dev/null || true
}
worker_running() {
  local pid=$1
  local state
  kill -0 "$pid" 2>/dev/null || return 1
  state=$(awk '{print $3}' "/proc/$pid/stat" 2>/dev/null || true)
  [[ $state != Z && -n $state ]]
}
cleanup_launcher() {
  local status=$?
  # Cleanup must be idempotent against repeated terminal signals.  Mask them
  # before removing EXIT ownership so no second signal can strand descendants.
  trap '' INT TERM HUP
  trap - EXIT
  stop_watcher
  if [[ -n $current_lease_id ]]; then
    "${channel_command[@]}" tui-recovery-target clear-owned "$current_lease_id" \
      "${runtime_args[@]}" >/dev/null 2>&1 || true
  fi
  stop_worker_group tui "$tui_pid" "$tui_start_ticks" "$tui_pgid"
  stop_worker_group gateway "$gateway_pid" "$gateway_start_ticks" "$gateway_pgid"
  stop_worker_group app "$app_pid" "$app_start_ticks" "$app_pgid"
  if [[ -n $launch_generation ]]; then
    run_generation finish-owned --nonce "$launch_generation" >/dev/null 2>&1 || true
  fi
  exit "$status"
}
trap cleanup_launcher EXIT
trap 'exit 130' INT
trap 'exit 143' TERM
trap 'exit 129' HUP

exec {launcher_lock_fd}>"$lock_file"
if ! flock -n "$launcher_lock_fd"; then
  echo "Discord instance $instance already has an active launcher" >&2
  exit 73
fi
set +e
run_generation prepare --timeout-ms "$stop_timeout_ms" >/dev/null
prepare_status=$?
set -e
if ((prepare_status != 0)); then
  echo "Discord instance $instance already has an app-server socket; stop the legacy service before relaunching" >&2
  exit 73
fi
if [[ -e $socket || -e $generation_manifest ]]; then
  echo "Discord instance $instance has ambiguous launcher state" >&2
  exit 73
fi
launch_generation=$(tr -d '\n' </proc/sys/kernel/random/uuid)
generation_env=(
  CODEX_DISCORD_LAUNCH_GENERATION="$launch_generation"
  CODEX_DISCORD_LAUNCH_INSTANCE="$instance"
  CODEX_DISCORD_LAUNCH_STATE_DIR="$state_dir"
  CODEX_DISCORD_LAUNCH_CODEX_HOME="$codex_home"
  CODEX_DISCORD_LAUNCH_PLUGIN_ROOT="$plugin_root"
  CODEX_DISCORD_LAUNCH_ENDPOINT="$socket"
)

umask 077
(
  exec {launcher_lock_fd}>&-
  exec "$setsid_bin" env "${generation_env[@]}" CODEX_DISCORD_LAUNCH_ROLE=app \
    "${generation_command[@]}" supervise \
    --manifest "$generation_manifest" \
    --nonce "$launch_generation" \
    --instance "$instance" \
    --state-dir "$state_dir" \
    --codex-home "$codex_home" \
    --plugin-root "$plugin_root" \
    --socket "$socket" \
    --node-bin "$node_bin" \
    --codex-bin "$codex_bin" \
    --channel-bin "$channel_bin" \
    --generation-bin "$generation_bin" \
    --launcher-pid "$launcher_pid" \
    --launcher-start-ticks "$launcher_start_ticks" \
    -- "${channel_command[@]}" app-server "${runtime_args[@]}"
) >>"$state_dir/app-server.log" 2>&1 &
app_pid=$!
if ! read -r app_start_ticks app_pgid < <(record_worker_group "$app_pid"); then
  echo "Discord app-server generation for $instance did not isolate its process group" >&2
  exit 1
fi
(
  exec {launcher_lock_fd}>&-
  exec "$setsid_bin" env "${generation_env[@]}" CODEX_DISCORD_LAUNCH_ROLE=gateway \
    "${channel_command[@]}" gateway "${runtime_args[@]}"
) >>"$state_dir/session-gateway.log" 2>&1 &
gateway_pid=$!
if ! read -r gateway_start_ticks gateway_pgid < <(record_worker_group "$gateway_pid"); then
  echo "Discord gateway for $instance did not isolate its process group" >&2
  exit 1
fi

deadline=$((SECONDS + timeout_seconds))
while ((SECONDS <= deadline)); do
  # Readiness requires the manifest's exact app group to own the only listener;
  # observing a pathname alone never grants cleanup authority.
  if ! worker_running "$app_pid"; then
    echo "Discord app-server for $instance exited during startup; see $state_dir/app-server.log" >&2
    exit 1
  fi
  if ! worker_running "$gateway_pid"; then
    echo "Discord gateway for $instance exited during startup; see $state_dir/session-gateway.log" >&2
    exit 1
  fi
  if [[ -S $socket ]]; then
    if ! run_generation ready --nonce "$launch_generation" >/dev/null 2>&1; then
      sleep 0.05
      continue
    fi
    "${channel_command[@]}" live-check "${runtime_args[@]}" \
      --pid "$app_pid" --pid "$gateway_pid" >/dev/null
    codex_args=("$@")
    recovery_stamps=()
    while true; do
      tui_socket_generation=$(socket_generation)
      launch_mtime_ms=$("$node_bin" -e 'process.stdout.write(String(Date.now()))')
      current_lease_id=$(tr -d '\n' </proc/sys/kernel/random/uuid)
      begin_tui_lease "$current_lease_id" "$launch_mtime_ms"
      watcher_stop=$(mktemp "$state_dir/.tui-recovery-stop.XXXXXX")
      rm -f "$watcher_stop"
      (
        exec {launcher_lock_fd}>&-
        while [[ ! -e $watcher_stop ]] && kill -0 "$launcher_pid" 2>/dev/null; do
          snapshot_recovery_target "$launch_mtime_ms" "$current_lease_id" 2>/dev/null || true
          sleep 0.2
        done
      ) &
      watcher_pid=$!

      set +e
      (
        exec {launcher_lock_fd}>&-
        exec "$setsid_bin" env \
          "${child_env_unsets[@]}" \
          -u CODEX_THREAD_ID \
          -u CODEX_SESSION_ID \
          -u CODEX_TARGET_THREAD_ID \
          -u CODEX_APP_SERVER_SOCKET \
          CODEX_HOME="$codex_home" \
          DISCORD_INSTANCE="$instance" \
          DISCORD_CONFIG_DIR="$state_dir" \
          CODEX_DISCORD_DELIVERY_ACTIVATION_ID="$plugin_root" \
          "${generation_env[@]}" \
          CODEX_DISCORD_LAUNCH_ROLE=tui \
          "$node_bin" "$codex_bin" --remote "unix://$socket" "${codex_args[@]}" \
          <&0 >&1 2>&2
      ) &
      tui_pid=$!
      if ! read -r tui_start_ticks tui_pgid < <(record_worker_group "$tui_pid"); then
        echo "Discord TUI for $instance did not isolate its process group" >&2
        exit 1
      fi
      completed_pid=''
      wait -n -p completed_pid "$tui_pid" "$app_pid" "$gateway_pid"
      child_status=$?
      set -e
      if [[ $completed_pid != "$tui_pid" ]]; then
        failed_worker=app-server
        if [[ $completed_pid == "$gateway_pid" ]]; then
          failed_worker=gateway
          gateway_pid=''
        elif [[ $completed_pid == "$app_pid" ]]; then
          app_pid=''
        fi
        stop_worker_group tui "$tui_pid" "$tui_start_ticks" "$tui_pgid"
        tui_pid=''
        tui_start_ticks=''
        tui_pgid=''
        echo "Discord $failed_worker for $instance exited while the TUI was active" >&2
        exit 75
      fi
      tui_status=$child_status
      # wait -n reaps only the TUI group leader.  Keep its exact identity until
      # the rest of that isolated generation group has also been terminated.
      stop_worker_group tui "$tui_pid" "$tui_start_ticks" "$tui_pgid"
      tui_pid=''
      tui_start_ticks=''
      tui_pgid=''
      stop_watcher
      snapshot_recovery_target "$launch_mtime_ms" "$current_lease_id" 2>/dev/null || true

      if ((tui_status == 0 || tui_status == 130 || tui_status == 143)); then
        "${channel_command[@]}" tui-recovery-target clear-owned "$current_lease_id" \
          "${runtime_args[@]}" >/dev/null
        exit "$tui_status"
      fi

      current_generation=$(socket_generation 2>/dev/null || true)
      if [[ -n $current_generation && $current_generation == "$tui_socket_generation" ]]; then
        exit "$tui_status"
      fi

      recovery_deadline=$((SECONDS + recovery_timeout_seconds))
      next_generation=''
      while ((SECONDS <= recovery_deadline)); do
        next_generation=$(socket_generation 2>/dev/null || true)
        if [[ -n $next_generation && $next_generation != "$tui_socket_generation" ]]; then
          break
        fi
        sleep 0.1
      done
      if [[ -z $next_generation || $next_generation == "$tui_socket_generation" ]]; then
        exit "$tui_status"
      fi
      if ! run_generation update-endpoint --nonce "$launch_generation" >/dev/null 2>&1; then
        exit "$tui_status"
      fi

      set +e
      recovery_thread=$(read_recovery_target 2>/dev/null)
      recovery_target_status=$?
      set -e
      if ((recovery_target_status != 0)) || [[ -z $recovery_thread ]]; then
        exit "$tui_status"
      fi

      now_seconds=$(date +%s)
      retained_stamps=()
      for stamp in "${recovery_stamps[@]}"; do
        if ((now_seconds - stamp < 60)); then
          retained_stamps+=("$stamp")
        fi
      done
      recovery_stamps=("${retained_stamps[@]}")
      if ((${#recovery_stamps[@]} >= 5)); then
        echo "App-server recovery stopped after five replacements in one minute" >&2
        exit 75
      fi
      recovery_stamps+=("$now_seconds")

      recovered_args=()
      option_index=0
      while ((option_index < ${#codex_args[@]})); do
        arg=${codex_args[$option_index]}
        if [[ $arg == -- ]] || [[ $arg != -* ]]; then
          break
        fi
        case $arg in
          --oss|--full-auto|--dangerously-bypass-approvals-and-sandbox|--search|--no-alt-screen)
            recovered_args+=("$arg")
            option_index=$((option_index + 1))
            ;;
          --image=*)
            option_index=$((option_index + 1))
            ;;
          --config=*|--enable=*|--disable=*|--model=*|--local-provider=*|--profile=*|--sandbox=*|--ask-for-approval=*|--cd=*|--add-dir=*)
            recovered_args+=("$arg")
            option_index=$((option_index + 1))
            ;;
          -i|--image)
            if ((option_index + 1 >= ${#codex_args[@]})); then
              echo "App-server recovery cannot discard $arg without its value" >&2
              exit "$tui_status"
            fi
            option_index=$((option_index + 2))
            ;;
          -c|--config|--enable|--disable|-m|--model|--local-provider|-p|--profile|-s|--sandbox|-a|--ask-for-approval|-C|--cd|--add-dir)
            if ((option_index + 1 >= ${#codex_args[@]})); then
              echo "App-server recovery cannot preserve $arg without its value" >&2
              exit "$tui_status"
            fi
            recovered_args+=("$arg" "${codex_args[$((option_index + 1))]}")
            option_index=$((option_index + 2))
            ;;
          *)
            echo "App-server recovery refuses unknown global option $arg" >&2
            exit "$tui_status"
            ;;
        esac
      done
      recovered_args+=(resume "$recovery_thread")
      codex_args=("${recovered_args[@]}")
      echo "App-server generation changed; resuming thread $recovery_thread." >&2
    done
  fi
  sleep 0.1
done

echo "Discord instance $instance did not become ready within the startup timeout" >&2
exit 1
