#!/usr/bin/env node
'use strict';

const { loadConfig } = require('../src/config');
const {
  configureNetwork,
  confirmDiscordMessage,
  prepareDiscordMessageSend,
  reconcileDiscordMessage,
  releaseDiscordReceiverOwnership,
  sendDiscordMessage,
  startDiscordClient,
} = require('../src/discord-client');
const { createDiscordRestClient } = require('../src/discord-rest-client');
const { createDelivery } = require('../src/delivery');
const { sendDiscordReplyOnce } = require('../src/reply-delivery');
const { startGatewayDrainLoop } = require('../src/gateway-drain-loop');
const { claimOwner, createOwner } = require('../src/owner-state');
const { instanceDoctor, runAppServer } = require('../src/app-server-runtime');
const { runTui } = require('../src/instance-launcher');

function usage() {
  process.stderr.write([
    'Usage:',
    '  codex-discord-channel              # run MCP server',
    '  codex-discord-channel gateway [--instance ID --state-dir PATH]',
    '  codex-discord-channel app-server [--instance ID --state-dir PATH]',
    '  codex-discord-channel instance-doctor [--instance ID --state-dir PATH]',
    '  codex-discord-channel tui-check [--instance ID --state-dir PATH]',
    '  codex-discord-channel live-check [--instance ID --state-dir PATH] --pid PID --pid PID',
    '  codex-discord-channel tui [--instance ID --state-dir PATH] [-- CODEX_ARGS...]',
    '  codex-discord-channel tui-recovery-target ACTION [MIN_MTIME_MS] [--instance ID --state-dir PATH]',
    '  codex-discord-channel send [--channel CHANNEL_ID] [--reply-to MESSAGE_ID] [--followup]',
    '',
    'The send command reads message text from stdin. A guarded reply requires exact --channel and --reply-to values.',
  ].join('\n'));
  process.stderr.write('\n');
}

function parseTuiArgs(argv) {
  const separator = argv.indexOf('--');
  const runtimeArgs = separator === -1 ? argv : argv.slice(0, separator);
  const codexArgs = separator === -1 ? [] : argv.slice(separator + 1);
  return { codexArgs, runtimeArgs };
}

function parseLiveCheckArgs(argv) {
  const runtimeArgs = [];
  const pids = [];
  for (let index = 0; index < argv.length; index += 1) {
    if (argv[index] === '--pid') {
      const pid = Number(argv[index + 1]);
      if (!Number.isSafeInteger(pid)) throw new Error('--pid requires an integer');
      pids.push(pid);
      index += 1;
    } else {
      runtimeArgs.push(argv[index]);
    }
  }
  if (pids.length !== 2) throw new Error('live-check requires exactly two --pid values');
  return { pids, runtimeArgs };
}

function parseRuntimeArgs(argv) {
  const env = {};
  for (let index = 0; index < argv.length; index += 1) {
    const arg = argv[index];
    if (arg === '--instance') {
      const value = argv[index + 1];
      if (!value) throw new Error('--instance requires a value');
      env.DISCORD_INSTANCE = value;
      index += 1;
    } else if (arg === '--state-dir') {
      const value = argv[index + 1];
      if (!value) throw new Error('--state-dir requires a value');
      env.DISCORD_CONFIG_DIR = value;
      index += 1;
    } else {
      throw new Error(`Unknown runtime argument: ${arg}`);
    }
  }
  return env;
}

function loadRuntimeConfig(argv, options = {}) {
  return loadConfig({ ...process.env, ...parseRuntimeArgs(argv) }, options);
}

function parseSendArgs(argv) {
  const args = { channelId: '', replyTo: '', followup: false };
  for (let index = 0; index < argv.length; index += 1) {
    const arg = argv[index];
    if (arg === '--channel') {
      args.channelId = argv[index + 1] || '';
      index += 1;
    } else if (arg === '--reply-to') {
      args.replyTo = argv[index + 1] || '';
      index += 1;
    } else if (arg === '--followup') {
      args.followup = true;
    } else if (arg === '-h' || arg === '--help') {
      args.help = true;
    } else {
      throw new Error(`Unknown argument: ${arg}`);
    }
  }
  return args;
}

function readStdin() {
  return new Promise((resolve, reject) => {
    let text = '';
    process.stdin.setEncoding('utf8');
    process.stdin.on('data', (chunk) => {
      text += chunk;
    });
    process.stdin.on('error', reject);
    process.stdin.on('end', () => resolve(text));
  });
}

async function sendViaRest(args, deps = {}) {
  const content = (await (deps.readStdin || readStdin)()).trim();
  if (!content) throw new Error('stdin message content is required');

  const config = deps.config || loadConfig();
  if (!config.tokenConfigured) {
    throw new Error(`Discord token is not configured in ${config.paths.envFile}`);
  }
  (deps.configureNetwork || configureNetwork)(config, () => {});
  const client = (deps.createDiscordRestClient || createDiscordRestClient)({
    token: config.token,
    botUserId: config.botUserId,
    fetchImpl: deps.fetchImpl || globalThis.fetch,
  });

  const sent = await sendDiscordReplyOnce({
    args,
    config,
    content,
    preflight: (target, identity) => prepareDiscordMessageSend(
      client,
      { ...args, ...target, ...identity, content },
    ),
    sender: (target, prepared, identity) => sendDiscordMessage(
      client,
      { ...args, ...target, ...identity, content },
      prepared,
    ),
    confirmer: (target, prepared, message, receipt) => confirmDiscordMessage(
      client,
      { ...args, ...target, nonce: receipt.nonce, enforceNonce: true, content },
      prepared,
      message,
    ),
    reconciler: (target, prepared, receipt) => reconcileDiscordMessage(
      client,
      { ...args, ...target, nonce: receipt.nonce, enforceNonce: true, content },
      prepared,
      receipt,
    ),
  });
  (deps.writeOutput || ((text) => process.stdout.write(text)))(`${JSON.stringify(sent)}\n`);
  return sent;
}

function makeLogger() {
  return (level, message, meta) => {
    const suffix = meta === undefined ? '' : ` ${JSON.stringify(meta)}`;
    process.stderr.write(`${new Date().toISOString()} ${level} ${message}${suffix}\n`);
  };
}

function enabled(value) {
  return /^(1|true|yes|on)$/i.test(String(value || '').trim());
}

async function runGateway(config = loadConfig()) {
  const logger = makeLogger();
  const delivery = createDelivery(config, logger);
  let discordState;
  try {
    discordState = await startDiscordClient({ config, delivery, logger, claimReceiver: true });
  } catch (error) {
    delivery.destroy();
    throw error;
  }
  if (!discordState.started) {
    delivery.destroy();
    throw new Error(`Discord gateway did not start: ${discordState.reason || 'unknown'}`);
  }
  const drainLoop = startGatewayDrainLoop({
    config,
    delivery,
    receiverOwnership: discordState.receiverOwnership,
    logger,
  });
  if (enabled(config.env.CODEX_DISCORD_GATEWAY_CLAIM_OWNER)) {
    try {
      claimOwner(config.paths.ownerPath, createOwner(config));
    } catch (error) {
      logger('ERROR', 'Failed to update optional Discord owner metadata', {
        error: error instanceof Error ? error.message : String(error),
      });
    }
  }
  const keepAlive = setInterval(() => {}, 2 ** 30);
  let stopping = false;
  const stop = async () => {
    if (stopping) return;
    stopping = true;
    clearInterval(keepAlive);
    if (typeof delivery.deactivateReceiver === 'function') delivery.deactivateReceiver();
    try {
      if (discordState.client?.destroy) await discordState.client.destroy();
    } catch {}
    await drainLoop.stop();
    try {
      await delivery.coordinateReceiverOwnership(() => releaseDiscordReceiverOwnership(
        config,
        discordState.receiverOwnership,
      ));
    } catch {}
    if (typeof delivery.destroy === 'function') delivery.destroy();
    process.exit(0);
  };
  process.once('SIGTERM', () => { void stop(); });
  process.once('SIGINT', () => { void stop(); });
}

async function main() {
  const [command, ...rest] = process.argv.slice(2);
  if (!command) {
    await require('../src/mcp-server').main();
    return;
  }
  if (command === 'send') {
    const args = parseSendArgs(rest);
    if (args.help) {
      usage();
      return;
    }
    await sendViaRest(args);
    return;
  }
  if (command === 'gateway') {
    await runGateway(loadRuntimeConfig(rest));
    return;
  }
  if (command === 'app-server') {
    const code = await runAppServer(loadRuntimeConfig(rest, { loadDiscordEnv: false }));
    if (code !== 0) process.exitCode = code;
    return;
  }
  if (command === 'instance-doctor') {
    process.stdout.write(`${JSON.stringify(instanceDoctor(loadRuntimeConfig(rest)), null, 2)}\n`);
    return;
  }
  if (command === 'tui-check') {
    require('../src/instance-launcher').requireInstanceReady(loadRuntimeConfig(rest));
    return;
  }
  if (command === 'tui-login-state') {
    try {
      require('../src/instance-launcher').requireInstanceReady(loadRuntimeConfig(rest));
    } catch (error) {
      if (error?.code !== 'openai_account_login_missing') throw error;
      process.exitCode = 10;
    }
    return;
  }
  if (command === 'live-check') {
    const args = parseLiveCheckArgs(rest);
    const config = loadRuntimeConfig(args.runtimeArgs);
    const { verifyLiveProcess } = require('../src/instance-launcher');
    for (const pid of args.pids) verifyLiveProcess(config, pid);
    return;
  }
  if (command === 'tui') {
    const args = parseTuiArgs(rest);
    runTui(loadRuntimeConfig(args.runtimeArgs), args.codexArgs);
    return;
  }
  if (command === 'tui-recovery-target') {
    const [action, maybeMtime, ...runtimeTail] = rest;
    const hasMtime = action === 'snapshot';
    const runtimeArgs = hasMtime ? runtimeTail : rest.slice(1);
    const minimumMtimeMs = hasMtime ? Number(maybeMtime) : 0;
    if (!['snapshot', 'read', 'clear'].includes(action)) {
      throw new Error('tui-recovery-target action must be snapshot, read, or clear');
    }
    if (hasMtime && (!/^\d+$/.test(maybeMtime || '') || !Number.isSafeInteger(minimumMtimeMs))) {
      throw new Error('tui-recovery-target snapshot requires a non-negative millisecond timestamp');
    }
    const config = loadRuntimeConfig(runtimeArgs);
    const target = require('../src/tui-recovery-target');
    if (action === 'snapshot') {
      if (!target.captureRecoveryTarget(config, minimumMtimeMs)) process.exitCode = 10;
    } else if (action === 'read') {
      const threadId = target.readRecoveryThread(config);
      if (!threadId) process.exitCode = 10;
      else process.stdout.write(`${threadId}\n`);
    } else {
      target.clearRecoveryTarget(config);
    }
    return;
  }
  if (command === '-h' || command === '--help') {
    usage();
    return;
  }
  throw new Error(`Unknown command: ${command}`);
}

module.exports = {
  main,
  parseLiveCheckArgs,
  parseRuntimeArgs,
  parseSendArgs,
  parseTuiArgs,
  readStdin,
  sendViaRest,
};

if (require.main === module) {
  main().catch((error) => {
    process.stderr.write(`${error instanceof Error ? error.stack : String(error)}\n`);
    process.exit(1);
  });
}
