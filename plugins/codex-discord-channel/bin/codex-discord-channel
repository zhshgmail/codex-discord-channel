#!/usr/bin/env node
'use strict';

const net = require('node:net');
const { loadConfig } = require('../src/config');
const { AppServerRpcClient, endpointToWebSocket } = require('../src/app-server-host');
const { configureNetwork, releaseDiscordReceiverOwnership } = require('../src/discord-client');
const { createDelivery, resolveReplyTarget } = require('../src/delivery');
const { startGatewayDrainLoop } = require('../src/gateway-drain-loop');
const { startDiscordClient } = require('../src/discord-client');
const { claimOwner, createOwner } = require('../src/owner-state');

function usage() {
  process.stderr.write([
    'Usage:',
    '  codex-discord-channel              # run MCP server',
    '  codex-discord-channel gateway      # run Discord gateway without MCP stdio',
    '  codex-discord-channel send [--channel CHANNEL_ID] [--reply-to MESSAGE_ID]',
    '',
    'The send command reads message text from stdin. Without --channel it replies to the last accepted inbound Discord message.',
  ].join('\n'));
  process.stderr.write('\n');
}

function parseSendArgs(argv) {
  const args = { channelId: '', replyTo: '' };
  for (let index = 0; index < argv.length; index += 1) {
    const arg = argv[index];
    if (arg === '--channel') {
      args.channelId = argv[index + 1] || '';
      index += 1;
    } else if (arg === '--reply-to') {
      args.replyTo = argv[index + 1] || '';
      index += 1;
    } else if (arg === '-h' || arg === '--help') {
      args.help = true;
    } else {
      throw new Error(`Unknown argument: ${arg}`);
    }
  }
  return args;
}

function parseAppServerProbeArgs(argv) {
  const args = { endpoint: '', timeoutMs: 10000 };
  for (let index = 0; index < argv.length; index += 1) {
    const arg = argv[index];
    if (arg === '--endpoint') {
      args.endpoint = argv[index + 1] || '';
      index += 1;
    } else if (arg === '--timeout-ms') {
      args.timeoutMs = Number.parseInt(argv[index + 1] || '', 10);
      index += 1;
    } else {
      throw new Error(`Unknown app-server probe argument: ${arg}`);
    }
  }
  if (!args.endpoint.startsWith('unix:///')) {
    throw new Error('App-server probe requires an absolute Unix socket endpoint.');
  }
  if (!Number.isInteger(args.timeoutMs) || args.timeoutMs <= 0) {
    throw new Error('App-server probe timeout must be a positive integer.');
  }
  return args;
}

async function probeAppServer(args, deps = {}) {
  const createClient = deps.createClient || ((config) => new AppServerRpcClient(config));
  const client = createClient({
    appServerUrl: args.endpoint,
    appServerConnectTimeoutMs: args.timeoutMs,
    appServerRequestTimeoutMs: args.timeoutMs,
  });
  try {
    await client.ensureConnected();
    return { available: true };
  } finally {
    client.destroy();
  }
}

async function probeUnixSocketListener(args, deps = {}) {
  const { socketPath } = endpointToWebSocket(args.endpoint);
  if (!socketPath) throw new Error('Unix listener probe requires a Unix socket endpoint.');
  const createConnection = deps.createConnection || net.createConnection;
  await new Promise((resolve, reject) => {
    let settled = false;
    let socket;
    const finish = (error) => {
      if (settled) return;
      settled = true;
      clearTimeout(timer);
      if (socket && typeof socket.destroy === 'function') socket.destroy();
      if (error) reject(error);
      else resolve();
    };
    const timer = setTimeout(
      () => finish(new Error('Timed out connecting to the Unix socket listener.')),
      args.timeoutMs,
    );
    try {
      socket = createConnection({ path: socketPath });
      socket.once('connect', () => finish());
      socket.once('error', finish);
    } catch (error) {
      finish(error);
    }
  });
  return { available: true };
}

function resolveSessionAppServerEndpoint(env = process.env) {
  const config = loadConfig(env);
  if (/[\u0000-\u001f\u007f]/.test(config.paths.stateDir)) {
    throw new Error('Discord state path must not contain ASCII control bytes.');
  }
  const endpoint = `unix://${config.paths.stateDir}/app-server.sock`;
  if (config.appServerUrl !== endpoint) {
    throw new Error(`Configured app-server endpoint must match the Discord state path: ${endpoint}`);
  }
  return endpoint;
}

function readStdin() {
  return new Promise((resolve, reject) => {
    let text = '';
    process.stdin.setEncoding('utf8');
    process.stdin.on('data', (chunk) => {
      text += chunk;
    });
    process.stdin.on('error', reject);
    process.stdin.on('end', () => resolve(text));
  });
}

async function sendViaRest(args) {
  const content = (await readStdin()).trim();
  if (!content) throw new Error('stdin message content is required');

  const config = loadConfig();
  const target = resolveReplyTarget(args, config);
  if (!config.tokenConfigured) {
    throw new Error(`Discord token is not configured in ${config.paths.envFile}`);
  }
  configureNetwork(config, () => {});

  const payload = { content };
  if (target.replyTo) {
    payload.message_reference = {
      message_id: target.replyTo,
      channel_id: target.channelId,
      fail_if_not_exists: false,
    };
  }

  const response = await fetch(`https://discord.com/api/v10/channels/${target.channelId}/messages`, {
    method: 'POST',
    headers: {
      Authorization: `Bot ${config.token}`,
      'Content-Type': 'application/json',
    },
    body: JSON.stringify(payload),
  });
  const bodyText = await response.text();
  let body;
  try {
    body = JSON.parse(bodyText);
  } catch {
    body = {};
  }
  if (!response.ok) {
    throw new Error(`Discord send failed ${response.status}: ${body.message || bodyText}`);
  }
  process.stdout.write(`${JSON.stringify({ channelId: body.channel_id, messageId: body.id })}\n`);
}

function makeLogger() {
  return (level, message, meta) => {
    const suffix = meta === undefined ? '' : ` ${JSON.stringify(meta)}`;
    process.stderr.write(`${new Date().toISOString()} ${level} ${message}${suffix}\n`);
  };
}

function enabled(value) {
  return /^(1|true|yes|on)$/i.test(String(value || '').trim());
}

async function runGateway() {
  const logger = makeLogger();
  const config = loadConfig();
  const delivery = createDelivery(config, logger);
  let discordState;
  try {
    discordState = await startDiscordClient({ config, delivery, logger, claimReceiver: true });
  } catch (error) {
    delivery.destroy();
    throw error;
  }
  if (!discordState.started) {
    delivery.destroy();
    throw new Error(`Discord gateway did not start: ${discordState.reason || 'unknown'}`);
  }
  const drainLoop = startGatewayDrainLoop({
    config,
    delivery,
    receiverOwnership: discordState.receiverOwnership,
    logger,
  });
  if (enabled(config.env.CODEX_DISCORD_GATEWAY_CLAIM_OWNER)) {
    try {
      claimOwner(config.paths.ownerPath, createOwner(config));
    } catch (error) {
      logger('ERROR', 'Failed to update optional Discord owner metadata', {
        error: error instanceof Error ? error.message : String(error),
      });
    }
  }
  const keepAlive = setInterval(() => {}, 2 ** 30);
  let stopping = false;
  const stop = async () => {
    if (stopping) return;
    stopping = true;
    clearInterval(keepAlive);
    if (typeof delivery.deactivateReceiver === 'function') delivery.deactivateReceiver();
    try {
      if (discordState.client?.destroy) await discordState.client.destroy();
    } catch {}
    await drainLoop.stop();
    try {
      await delivery.coordinateReceiverOwnership(() => releaseDiscordReceiverOwnership(
        config,
        discordState.receiverOwnership,
      ));
    } catch {}
    if (typeof delivery.destroy === 'function') delivery.destroy();
    process.exit(0);
  };
  process.once('SIGTERM', () => { void stop(); });
  process.once('SIGINT', () => { void stop(); });
}

async function main() {
  const [command, ...rest] = process.argv.slice(2);
  if (!command) {
    await require('../src/mcp-server').main();
    return;
  }
  if (command === 'send') {
    const args = parseSendArgs(rest);
    if (args.help) {
      usage();
      return;
    }
    await sendViaRest(args);
    return;
  }
  if (command === 'gateway') {
    await runGateway();
    return;
  }
  if (command === 'app-server-probe') {
    const args = parseAppServerProbeArgs(rest);
    const result = await probeAppServer(args);
    process.stdout.write(`${JSON.stringify(result)}\n`);
    return;
  }
  if (command === 'app-server-socket-probe') {
    const args = parseAppServerProbeArgs(rest);
    const result = await probeUnixSocketListener(args);
    process.stdout.write(`${JSON.stringify(result)}\n`);
    return;
  }
  if (command === 'app-server-endpoint') {
    if (rest.length > 0) throw new Error('app-server-endpoint does not accept arguments.');
    process.stdout.write(`${resolveSessionAppServerEndpoint()}\n`);
    return;
  }
  if (command === '-h' || command === '--help') {
    usage();
    return;
  }
  throw new Error(`Unknown command: ${command}`);
}

module.exports = {
  main,
  parseAppServerProbeArgs,
  parseSendArgs,
  probeAppServer,
  probeUnixSocketListener,
  readStdin,
  resolveSessionAppServerEndpoint,
  sendViaRest,
};

if (require.main === module) {
  main().catch((error) => {
    process.stderr.write(`${error instanceof Error ? error.stack : String(error)}\n`);
    process.exit(1);
  });
}
